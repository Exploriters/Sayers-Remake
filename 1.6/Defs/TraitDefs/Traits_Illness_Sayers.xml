<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- ============================ DEBUG ============================ -->
	<!-- TODO Stability -->
	<!-- ============================ CotardSyndrome ============================ -->
	<TraitDef>
		<defName>Trait_CotardSyndrome</defName>
		<commonality>0</commonality>
		<degreeDatas>
			<li>
				<label>&lt;color=#ff4444&gt;&lt;b&gt;科塔尔综合症&lt;/b&gt;&lt;/color&gt;</label>
				<description>{PAWN_nameDef}坚信自己已经死了，[PAWN_pronoun]确信自己身上某些部分似乎已经腐烂了，而[PAWN_pronoun]只是一具尸体或者幽灵。</description>
				<statFactors>
					<InjuryHealingFactor>0.8</InjuryHealingFactor>
					<PainShockThreshold>1.2</PainShockThreshold>
				</statFactors>
			</li>
		</degreeDatas>
	</TraitDef>
	
	<ThoughtDef>
		<defName>Thought_CotardSyndrome</defName>
		<showBubble>false</showBubble>
		<workerClass>SayersRemake.ThoughtWorker_CotardSyndrome</workerClass>
		<stackLimit>1</stackLimit>
		<stages>
			<li>
				<label>科塔尔综合症</label>
				<description>猫感觉自己正在腐烂……</description>
				<baseMoodEffect>-5</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	
	<ThoughtDef>
		<defName>Thought_Other_CotardSyndrome</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>SayersRemake.ThoughtWorker_Other_Autism</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<stages>
			<li>
				<label>举止奇怪(科塔尔综合症)</label>
				<baseOpinionOffset>-10</baseOpinionOffset>
			</li>
		</stages>
		<nullifyingTraits>
			<li>Kind</li>
			<li>Trait_CotardSyndrome</li>
		</nullifyingTraits>
	</ThoughtDef>
	<!-- ============================ Autism ============================ -->
	<TraitDef>
		<defName>Trait_Autism</defName>
		<commonality>0</commonality>
		<degreeDatas>
			<li>
				<label>&lt;color=#ff4444&gt;&lt;b&gt;自闭症&lt;/b&gt;&lt;/color&gt;</label>
				<description>{PAWN_nameDef}患有一定程度上的精神发育障碍，[PAWN_pronoun]的兴趣范围狭窄、行为方式刻板且具有一定的交流障碍。</description>
				<statFactors>
					<GlobalLearningFactor>0.2</GlobalLearningFactor>
					<RestRateMultiplier>0.8</RestRateMultiplier>
				</statFactors>
			</li>
		</degreeDatas>
	</TraitDef>
	
	<ThoughtDef>
		<defName>Thought_Other_Autism</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>SayersRemake.ThoughtWorker_Other_Autism</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<stages>
			<li>
				<label>举止奇怪(自闭症)</label>
				<baseOpinionOffset>-10</baseOpinionOffset>
			</li>
		</stages>
		<nullifyingTraits>
			<li>Kind</li>
			<li>Trait_Autism</li>
		</nullifyingTraits>
	</ThoughtDef>
	<!-- ============================ Narcolepsy ============================ -->
	<TraitDef>
		<defName>Trait_Narcolepsy</defName>
		<commonality>0</commonality>
		<degreeDatas>
			<li>
				<label>&lt;color=#ff4444&gt;&lt;b&gt;嗜睡症&lt;/b&gt;&lt;/color&gt;</label>
				<description>{PAWN_nameDef}总是感觉很疲惫，[PAWN_pronoun]无论睡了多久都容易犯困，且有些时候觉得自己的身体不是很受控，或是会看见什么不该看到的东西。</description>
				<statFactors>
					<RestFallRateFactor>8.0</RestFallRateFactor>
				</statFactors>
			</li>
		</degreeDatas>
	</TraitDef>
	
	<HediffDef>
		<defName>Hediff_Narcolepsy</defName>
		<label>猝倒</label>
		<description>此个体的肌肉品质暂时性消失，导致了头部或身体在没有丧失意识的情况下发生了瘫痪。</description>
		<tendable>false</tendable>
		<hediffClass>HediffWithComps</hediffClass>
		<stages>
			<li>
				<label>发作</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.7</setMax>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.2</offset>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.2</offset>
					</li>
					<li>
						<capacity>Talking</capacity>
						<offset>-0.4</offset>
					</li>
					<li>
						<capacity>Metabolism</capacity>
						<offset>-0.2</offset>
					</li>
					<li>
						<capacity>Sight</capacity>
						<offset>-0.15</offset>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>10800</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
	</HediffDef>
	
	<ThoughtDef>
		<defName>Thought_Narcolepsy</defName>
		<showBubble>true</showBubble>
		<icon>Things/Mote/ThoughtSymbol/GenericBad</icon>
		<durationDays>2</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>催眠性幻觉</label>
				<description>猫在恐惧中颤抖，它不知道它看见了什么，那扭曲至极的恐怖的东西，那是什么？它就在它的眼前……</description>
				<baseMoodEffect>-10</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	
	<!-- ============================ Sleep Paralysis ============================ -->
	<TraitDef>
		<defName>Trait_SleepParalysis</defName>
		<commonality>0</commonality>
		<degreeDatas>
			<li>
				<label>&lt;color=#ff4444&gt;&lt;b&gt;睡眠瘫痪&lt;/b&gt;&lt;/color&gt;</label>
				<description>{PAWN_nameDef}几乎无法休息……否则睡眠瘫痪可能会找上[PAWN_pronoun]。</description>
				<statFactors>
					<RestFallRateFactor>0.5</RestFallRateFactor>
				</statFactors>
				<statOffsets>
					<RestRateMultiplier>0.50</RestRateMultiplier>
				</statOffsets>
			</li>
		</degreeDatas>
	</TraitDef>
	
	<HediffDef>
		<defName>Hediff_SleepParalysis</defName>
		<label>睡眠瘫痪</label>
		<description>此个体虽然意识清醒但难以从睡眠中醒来，且无法操控自己的身体。\n这不是致命状态，哪怕置之不理，它会在一定时间后自行消失。</description>
		<tendable>false</tendable>
		<hediffClass>HediffWithComps</hediffClass>
		<stages>
			<li>
				<label>发作</label>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>172800</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
	</HediffDef>
	
	<ThoughtDef>
		<defName>Thought_SleepParalysis</defName>
		<showBubble>true</showBubble>
		<icon>Things/Mote/ThoughtSymbol/GenericBad</icon>
		<durationDays>2</durationDays>
		<stackLimit>5</stackLimit>
		<stages>
			<li>
				<label>睡眠瘫痪发作</label>
				<description>猫在恐惧中喘息，它的身体不再是它的了：它是如此痛苦，如此清醒，却动弹不得……</description>
				<baseMoodEffect>-10</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
</Defs>